<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="StatusEffectsEditorStyle.uss"/>
    <ui:TabView view-data-key="sef-tabs" class="sef-statuseffectgroup">
        <ui:Tab label="Datas" view-data-key="sef-datas" name="datas-tab">
            <ui:VisualElement class="sef-box-group" style="flex-grow: 1; flex-shrink: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; margin-bottom: -2px; padding-bottom: 1px;">
                <uie:ToolbarSearchField style="flex-grow: 1; width: auto; margin-left: 2px;"/>
            </ui:VisualElement>
            <ui:ListView virtualization-method="DynamicHeight" selection-type="Multiple" show-add-remove-footer="true" show-alternating-row-backgrounds="All" show-border="true"/>
        </ui:Tab>
        <ui:Tab label="Names" view-data-key="sef-names" name="names-tab">
            <ui:VisualElement class="sef-box-group" style="flex-grow: 1; flex-shrink: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; margin-bottom: -2px; padding-bottom: 1px;">
                <uie:ToolbarSearchField style="flex-grow: 1; width: auto; margin-left: 2px;"/>
            </ui:VisualElement>
            <ui:ListView virtualization-method="DynamicHeight" selection-type="Multiple" show-add-remove-footer="true" show-alternating-row-backgrounds="All" show-border="true"/>
        </ui:Tab>
        <ui:Tab label="Comparables" view-data-key="sef-comparables" name="comparables-tab">
            <ui:VisualElement class="sef-box-group" style="flex-grow: 1; flex-shrink: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; margin-bottom: -2px; padding-bottom: 1px;">
                <uie:ToolbarSearchField style="flex-grow: 1; width: auto; margin-left: 2px;"/>
            </ui:VisualElement>
            <ui:ListView virtualization-method="DynamicHeight" selection-type="Multiple" show-add-remove-footer="true" show-alternating-row-backgrounds="All" show-border="true"/>
        </ui:Tab>
        <ui:Tab label="Modules" view-data-key="sef-modules" name="modules-tab">
            <ui:VisualElement class="sef-box-group" style="flex-grow: 1; flex-shrink: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; margin-bottom: -2px; padding-bottom: 1px;">
                <uie:ToolbarSearchField style="flex-grow: 1; width: auto; margin-left: 2px;"/>
            </ui:VisualElement>
            <ui:ListView virtualization-method="DynamicHeight" selection-type="Multiple" show-add-remove-footer="true" show-alternating-row-backgrounds="All" show-border="true"/>
        </ui:Tab>
        <ui:Tab label="Dyn. Effects" view-data-key="sef-dynamic-effects" name="dynamic-effects-tab">
            <ui:VisualElement class="sef-box-group" style="flex-grow: 1; flex-shrink: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; margin-bottom: -2px; padding-bottom: 1px;">
                <uie:ToolbarSearchField style="flex-grow: 1; width: auto; margin-left: 2px;"/>
            </ui:VisualElement>
            <ui:ListView virtualization-method="DynamicHeight" selection-type="Multiple" show-add-remove-footer="true" show-alternating-row-backgrounds="All" show-border="true"/>
        </ui:Tab>
        <ui:Tab label="Events" view-data-key="sef-events" name="events-tab">
            <ui:VisualElement class="sef-box-group" style="flex-grow: 1; flex-shrink: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; margin-bottom: -2px; padding-bottom: 1px;">
                <uie:ToolbarSearchField style="flex-grow: 1; width: auto; margin-left: 2px;"/>
            </ui:VisualElement>
            <ui:ListView virtualization-method="DynamicHeight" selection-type="Multiple" show-add-remove-footer="true" show-alternating-row-backgrounds="All" show-border="true"/>
        </ui:Tab>
        <ui:Tab label="Groups" view-data-key="sef-groups" name="groups-tab"/>
        <ui:Tab label="Paths" view-data-key="sef-paths" name="paths-tab"/>
    </ui:TabView>
</ui:UXML>
